# Copy this file to .env for local use. Do not commit .env.

# ── Core storage and versioned configuration ─────────────────────────────────
DB_PATH=data/intelligence.db
PROGRAMS_CONFIG_PATH=config/programs.yaml
INTELLIGENCE_WATCHLIST_PATH=config/intelligence_watchlists.yaml
KNOWLEDGE_DIR=knowledge

# ── Monitoring and bounded public-web collection ─────────────────────────────
CONNECTOR_POLL_INTERVAL=1800
CONNECTOR_TIMEOUT_SECONDS=10
GATHER_TIMEOUT_SECONDS=12
MAX_SEARCHES_PER_PROGRAM=4
MAX_RESPONSE_BYTES=1000000
USER_AGENT=venture-intelligence/0.1 (public-web-monitor)
CRAWLER_RENDER_ENABLED=false
CRAWLER_ENGINE=playwright
CRAWLER_FAILURE_THRESHOLD=3
CRAWLER_CIRCUIT_COOLDOWN_SECONDS=60
BROWSER_TIMEOUT_MS=30000
# Direct LinkedIn/X/Instagram web automation is disabled by default. Indexed
# search discovery remains available through the Research Agent.
RESTRICTED_SOCIAL_ACCESS_MODE=search_discovery

# ── Bounded free/public research agent ───────────────────────────────────────
RESEARCH_MAX_QUERIES=20
RESEARCH_MAX_DEPTH=3
RESEARCH_MAX_RESULTS_PER_QUERY=5
RESEARCH_MAX_RUNTIME_SECONDS=30
RESEARCH_MAX_TOTAL_REQUESTS=30
RESEARCH_MAX_REQUESTS_PER_PROVIDER=12
RESEARCH_MAX_RETRY_REQUESTS=8
RESEARCH_MAX_REQUESTS_PER_DOMAIN=20
RESEARCH_CACHE_TTL_SECONDS=300
RESEARCH_ARXIV_ENABLED=true
# Scholar is opt-in public HTML discovery; blocked pages become structured failures.
RESEARCH_SCHOLAR_ENABLED=false
SEARCH_DUCKDUCKGO_ENABLED=true
SEARCH_BING_ENABLED=true
SEARCH_YAHOO_ENABLED=true
SEARCH_BRAVE_ENABLED=true
TECHCRUNCH_ENABLED=true
NEWSLETTER_WATCHLIST_ENABLED=true
VC_WATCHLIST_ENABLED=true
SOURCE_SETTINGS_PATH=data/source_settings.json
SOURCE_STATE_PATH=data/source_state.json
SOURCE_QUALITY_REPORT_PATH=data/source_quality/latest.json

# ── Scheduling and unattended operation ──────────────────────────────────────
OPERATIONS_STATE_PATH=data/operations/state.json
OPERATIONS_LOCK_PATH=data/operations/cycle.lock
OPERATIONS_LOCK_STALE_SECONDS=21600
SCHEDULER_INTERVAL_HOURS=12
SCHEDULER_ENABLED=true
# Two-part safety gate for the local M9 CLI. Keep disabled during normal runtime.
VENTURE_INTELLIGENCE_LIVE_TESTS=0

# ── GitHub (optional, public repositories, read-only) ─────────────────────────
# Optional fine-grained read-only token for higher official GitHub API quotas.
GITHUB_TOKEN=

# ── Product Hunt (optional official API) ──────────────────────────────────────
# Product Hunt API v2 uses an official read-only GraphQL token. Product Hunt's
# deployment/use restrictions remain the operator's responsibility.
PRODUCT_HUNT_API_ENABLED=false
PRODUCT_HUNT_ACCESS_TOKEN=
PRODUCT_HUNT_KNOWN_POSITIVE_POST_ID=139993

# ── Optional authorized integrations ─────────────────────────────────────────
# Authenticated Discord collection is not implemented in the current public
# boundary; these values remain disabled unless that boundary is added/reviewed.
DISCORD_API_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_AUTHORIZED_GUILD_IDS=
DISCORD_AUTHORIZED_CHANNEL_IDS=

# Reserved optional provider boundary; the default connector factory does not
# register Firecrawl.
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=

# ── Resolution, ranking, and alert thresholds ─────────────────────────────────
NAME_MATCH_THRESHOLD=0.82
ALERT_MIN_CONFIDENCE=0.65
ALERT_TOP_N_RANK=100

# ── Slack (optional — stdout always fires) ────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Optional email notifications (SMTP secrets stay in environment) ──────────
EMAIL_CONFIG_PATH=data/email_notifications.json
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=

# ── Optional local Ollama extraction ─────────────────────────────────────────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_INPUT_CHARS=4000
OLLAMA_OUTPUT_TOKENS=400

# ── Optional conversational analyst ──────────────────────────────────────────
ANALYST_ENABLED=true
# auto keeps deterministic grounded chat active and uses local Qwen when detected.
ANALYST_PROVIDER=auto

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
