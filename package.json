{
  "name": "venture-intelligence",
  "private": true,
  "type": "module",
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.101.4",
    "crawlee": "^3.13.0",
    "playwright": "1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.180.0"
  },
  "scripts": {
    "api:types": "uv run python scripts/export_openapi.py && openapi-typescript frontend/src/api/openapi.json -o frontend/src/api/schema.d.ts",
    "build": "pnpm api:types && vite build --config frontend/vite.config.ts",
    "crawl:public": "node scripts/crawlee_public_fetcher.mjs",
    "dev": "vite --config frontend/vite.config.ts",
    "lint": "eslint \"frontend/src/**/*.{ts,tsx}\" frontend/vite.config.ts --max-warnings=0",
    "preview": "vite preview --config frontend/vite.config.ts",
    "test": "vitest run --config frontend/vite.config.ts",
    "test:watch": "vitest --config frontend/vite.config.ts",
    "typecheck": "pnpm api:types && tsc --noEmit -p frontend/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
